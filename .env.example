# --- Обязательное ---
# Ключ Anthropic для VLM-коуча (coach/client.py). Держать ТОЛЬКО в .env.
ANTHROPIC_API_KEY=sk-ant-...

# --- Пайплайн (Stage B3) ---
DATABASE_URL=sqlite:///./aim_coach.db
UPLOAD_DIR=uploads
# Кому разрешён доступ к API из браузера (через запятую).
# ALLOWED_ORIGINS=http://localhost:3000
# Лимит размера загружаемого клипа, МБ.
# MAX_UPLOAD_MB=300
# Каталог кадров-улик (раздаётся как /evidence). По умолчанию uploads/evidence.
# EVIDENCE_DIR=uploads/evidence
# Веса YOLO-детектора голов (conf=0.4 зашит — калибровка закрыта).
# YOLO_WEIGHTS=runs/detect/heads_v3/weights/best.pt
# Каталог продольных профилей игроков.
# PROFILE_DIR=profiles

# --- Коуч ---
# Модель Claude для коуча (по умолчанию claude-sonnet-5).
# COACH_MODEL=claude-sonnet-5
# Кап картинок-улик в запросе коуча (цена; валидатор B2 страхует качество).
# COACH_MAX_IMAGES=5
# Глубина рассуждения коуча (экономия токенов). low = терсеее и дешевле,
# по умолчанию low. Пусто (COACH_EFFORT=) = не слать effort — нужно для
# моделей без его поддержки (напр. claude-haiku-4-5 иначе вернёт 400).
# COACH_EFFORT=low
