# --- Обязательное ---
# Ключ Google Gemini для VLM-коуча (провайдер по умолчанию). Создать:
# https://aistudio.google.com/apikey . Держать ТОЛЬКО в .env.
GEMINI_API_KEY=AIza...
# Ключ Anthropic — нужен только при COACH_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=sk-ant-...

# --- Пайплайн (Stage B3) ---
DATABASE_URL=sqlite:///./aim_coach.db
UPLOAD_DIR=uploads
# Очередь разборов: background (в процессе API, дефолт для dev) | arq
# (Redis: разбор переживает рестарт API, исполняет backend/worker.py:
#   python -m arq backend.worker.WorkerSettings).
# QUEUE_BACKEND=background
# REDIS_URL=redis://localhost:6379/0
# Параллельных разборов на воркер (GPU: один за раз).
# WORKER_MAX_JOBS=1
# Кому разрешён доступ к API из браузера (через запятую).
# ALLOWED_ORIGINS=http://localhost:3000
# Лимит размера загружаемого клипа, МБ.
# MAX_UPLOAD_MB=300
# Каталог кадров-улик (раздаётся как /evidence). По умолчанию uploads/evidence.
# EVIDENCE_DIR=uploads/evidence
# Веса YOLO-детектора голов (conf=0.4 зашит — калибровка закрыта).
# YOLO_WEIGHTS=runs/detect/heads_v3/weights/best.pt
# Каталог продольных профилей игроков.
# PROFILE_DIR=profiles

# --- Коуч ---
# Провайдер LLM коуча: gemini (по умолчанию) | anthropic.
# COACH_PROVIDER=gemini
# Модель коуча. Для gemini: gemini-3.5-flash (дефолт), gemini-3.1-flash-lite.
# Для anthropic: claude-sonnet-5 (дефолт), claude-haiku-4-5.
# COACH_MODEL=gemini-3.5-flash
# Кап картинок-улик в запросе коуча (цена; валидатор B2 страхует качество).
# COACH_MAX_IMAGES=5
# Глубина рассуждения коуча (экономия токенов). low = терсеее и дешевле,
# по умолчанию low. Пусто (COACH_EFFORT=) = не слать effort — нужно для
# моделей без его поддержки (напр. claude-haiku-4-5 иначе вернёт 400).
# COACH_EFFORT=low
